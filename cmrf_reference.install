<?php

/**
 * Migrate comma-separated multiple values in single records to delta-based
 * multiple records.
 */
function cmrf_reference_update_9101(&$sandbox) {
  $batchLimit = 25;

  // Retrieve affected webforms.
  if (!isset($sandbox['webformIds'])) {
    $webformStorage = \Drupal::entityTypeManager()->getStorage('webform');
    $webformQuery = $webformStorage
      ->getQuery()
      ->accessCheck(FALSE)
      // TODO: Is this filter safe? Do we need to filter for "cmrf_radios", too?
      ->condition('elements', "'#type': cmrf_reference", 'CONTAINS');
    $sandbox['webformIds'] = $webformQuery->execute();
    $sandbox['webformsTotal'] = count($sandbox['webformIds']);
    $sandbox['submissionIds'] = [];
  }

  // Re-fill submission IDs for remaining webforms.
  while (
    count($sandbox['webformIds']) !== 0 && empty($sandbox['submissionIds'])
  ) {
    $webformId = array_shift($sandbox['webformIds']);
    $webform = \Drupal\webform\Entity\Webform::load($webformId);
    if (!$webform->hasSubmissions()) {
      continue;
    }
    $elements = $webform->getElementsInitializedFlattenedAndHasValue() ?? [];
    $elements = array_filter($elements, function($element) {
      // TODO: Do we need to filter for "cmrf_radios", too?
      return
        'cmrf_reference' === $element['#type']
        && $element['#cmrf_multiple'];
    });
    if (count($elements) === 0) {
      continue;
    }
    $submissionStorage = \Drupal::entityTypeManager()
      ->getStorage('webform_submission');
    $submissionQuery = $submissionStorage
      ->getQuery()
      ->accessCheck(FALSE)
      ->condition('webform_id', $webformId);
    $sandbox['submissionIds'] += $submissionQuery->execute();
    $sandbox['elements'] = $elements;
  }

  // Process a batch of already retrieved webform submissions.
  foreach (array_splice($sandbox['submissionIds'], 0, $batchLimit) as $submissionId) {
    $submission = \Drupal\webform\Entity\WebformSubmission::load($submissionId);
    $saveSubmission = FALSE;
    $submissionData = array_intersect_key($submission->getData(),  $sandbox['elements']);
    // Transform comma-separated multi-value records into delta-based
    // separate records.
    foreach ($submissionData as $elementName => &$value) {
      // Affected values will only have one item.
      if (count($value) !== 1 || FALSE === strpos($value[0], ',')) {
        continue;
      }
      $value = explode(',', $value[0]);
      $saveSubmission = TRUE;
    }
    if ($saveSubmission) {
      $submission->setData($submissionData)->save();
    }
  }

  $webformsProcessed = $sandbox['webformsTotal'] - count($sandbox['webformIds']);
  if (count($sandbox['webformIds']) === 0 && count($sandbox['submissionIds']) === 0) {
    $sandbox['#finished'] = 1;
  }
  else {
    $webformsProcessed--;
    $sandbox['#finished'] = $webformsProcessed / $sandbox['webformsTotal'];
  }

  return \Drupal::translation()->formatPlural(
    $webformsProcessed,
    '@current webform processed.',
    '@current webforms processed.',
    ['@current' => $webformsProcessed]
  );
}
